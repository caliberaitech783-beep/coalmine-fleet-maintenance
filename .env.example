ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_CONNECT_STRING=host:1521/service-name

# Meta WhatsApp Cloud API (keep the access token in environment settings only)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0

# WhatsApp delivery provider: meta or fast2sms
WHATSAPP_PROVIDER=meta
FAST2SMS_WHATSAPP_API_KEY=

# Direct media uploads. Azure is used when AZURE_STORAGE_CONNECTION_STRING is
# present; otherwise configure an S3-compatible bucket. MEDIA_STORAGE_PROVIDER
# can be set explicitly to azure or s3.
MEDIA_STORAGE_PROVIDER=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nerve-center-media

# S3-compatible alternative (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
