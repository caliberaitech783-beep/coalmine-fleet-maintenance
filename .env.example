ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_CONNECT_STRING=host:1521/service-name

# Meta WhatsApp Cloud API (keep the access token in environment settings only)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0

# WhatsApp delivery provider: meta or fast2sms
WHATSAPP_PROVIDER=meta
FAST2SMS_WHATSAPP_API_KEY=

# Deletion approval: Fast2SMS WhatsApp authentication template; no DLT/Smart OTP ID.
# The owner recipient is fixed server-side at +919925565281.
# Optional key override. Otherwise reuses the saved providerApiKey,
# FAST2SMS_WHATSAPP_API_KEY, or legacy FAST2SMS_API_KEY.
DELETION_FAST2SMS_API_KEY=
# Reuses saved WhatsApp phoneNumberId/businessAccountId or META_WHATSAPP_* above.
# Optional template override; defaults to existing nerve_password_reset_otp.
DELETION_WHATSAPP_TEMPLATE_NAME=nerve_password_reset_otp
DELETION_WHATSAPP_TEMPLATE_LANGUAGE=en_US
